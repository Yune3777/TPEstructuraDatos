#decidimos hacer un data set nuevo, ya que el anterior tenia muchas canciones repetidas (a cruzar los dedos)




import pandas as pd
import numpy as np
import re

# ---------------------------------------------------------
# 1. PARÁMETROS Y REGLAS DEL CURADOR
# ---------------------------------------------------------
N_TARGET = 10000
PORC_ARG_MIN = 0.20  # 20% mínimo de artistas argentinos (2000 canciones)

GENEROS_PERMITIDOS = {
    "Pop", "Rock", "Rock argentino", "Rock alternativo", "Grunge", "Hard rock", 
    "Heavy metal", "Hip hop", "Rap", "R&B", "Soul", "Funk", "Dance", "Eurodance", 
    "House", "Techno", "Trance", "Reggae", "Reggaeton", "Ska", "Punk", "Pop rock", 
    "Balada", "Música latina", "Salsa", "Merengue", "Cumbia", "Folklore"
}

IDIOMAS_PERMITIDOS = {
    "Español", "Inglés", "Italiano", "Francés", "Brasilero", "Turco", "Árabe"
}

CUOTAS_GRUPOS = {
    "Pop internacional": 0.15,
    "Rock internacional": 0.15,
    "Dance / Eurodance / electrónica": 0.10,
    "R&B / Soul / Funk": 0.07,
    "Hip hop / Rap": 0.07,
    "Grunge / Alternative": 0.06,
    "Hard rock / Metal": 0.05,
    "Música latina": 0.10,
    "Pop en español": 0.07,
    "Rock argentino": 0.08,
    "Otros géneros": 0.10
}

PATRONES_REMASTER = re.compile(
    r'\b(remastered|remasterizado|remaster|digitally remastered|reissue|deluxe|anniversary edition)\b', 
    flags=re.IGNORECASE
)

# ---------------------------------------------------------
# 2. FUNCIONES DE LIMPIEZA Y VALIDACIÓN
# ---------------------------------------------------------
def es_remaster(titulo):
    """Detecta si el título contiene términos de remasterización o reedición."""
    if not isinstance(titulo, str):
        return True
    return bool(PATRONES_REMASTER.search(titulo))

def calcular_rating(row):
    """
    Calcula rating de 1.0 a 10.0:
    - 40% Popularidad streaming normalizada
    - 40% Desempeño en charts de la época
    - 20% Relevancia cultural en Argentina
    """
    pop = row.get('popularidad_streaming', np.nan)
    chart = row.get('desempeno_charts', np.nan)
    rel = row.get('relevancia_arg', np.nan)
    
    vali_pop = not np.isnan(pop)
    vali_chart = not np.isnan(chart)
    vali_rel = not np.isnan(rel)
    
    if vali_pop and vali_chart and vali_rel:
        score = (pop * 0.40) + (chart * 0.40) + (rel * 0.20)
        verificacion = "verificado"
    else:
        # Redistribución de pesos si falta algún componente
        pesos = []
        valores = []
        if vali_pop:
            pesos.append(0.40)
            valores.append(pop)
        if vali_chart:
            pesos.append(0.40)
            valores.append(chart)
        if vali_rel:
            pesos.append(0.20)
            valores.append(rel)
            
        if len(pesos) > 0:
            peso_total = sum(pesos)
            score = sum((val * (p / peso_total)) for val, p in zip(valores, pesos))
        else:
            score = 50.0  # Valor base por defecto
        verificacion = "no verificado"
    
    # Escalar de 0-100 a 1.0-10.0
    rating_final = round(1.0 + (score / 100.0) * 9.0, 1)
    return min(max(rating_final, 1.0), 10.0), verificacion

def mapear_grupo(genero, es_argentino, idioma):
    """Asigna la canción a uno de los 11 grupos estandarizados."""
    g = str(genero).strip()
    
    if g == "Rock argentino":
        return "Rock argentino"
    if g in ["Dance", "Eurodance", "House", "Techno", "Trance"]:
        return "Dance / Eurodance / electrónica"
    if g in ["R&B", "Soul", "Funk"]:
        return "R&B / Soul / Funk"
    if g in ["Hip hop", "Rap"]:
        return "Hip hop / Rap"
    if g in ["Grunge", "Rock alternativo"]:
        return "Grunge / Alternative"
    if g in ["Hard rock", "Heavy metal"]:
        return "Hard rock / Metal"
    if g in ["Música latina", "Salsa", "Merengue", "Cumbia", "Folklore"]:
        return "Música latina"
    if g == "Pop" and idioma == "Español":
        return "Pop en español"
    if g == "Pop" and idioma != "Español":
        return "Pop internacional"
    if g in ["Rock", "Pop rock", "Ska", "Punk"] and idioma != "Español":
        return "Rock internacional"
    
    return "Otros géneros"

# ---------------------------------------------------------
# 3. PROCESAMIENTO PRINCIPAL
# ---------------------------------------------------------
def procesar_catalogo(path_csv_entrada, path_csv_salida):
    # Cargar dataset base
    df = pd.read_csv(path_csv_entrada)
    total_inicial = len(df)
    
    # 1. Filtro de año estricto (1990 - 1999)
    df = df[(df['anio'] >= 1990) & (df['anio'] <= 1999)]
    
    # 2. Exclusión de remasters
    df = df[~df['nombre'].apply(es_remaster)]
    
    # 3. Limpieza de artistas principales (eliminar "feat.")
    df['artista'] = df['artista'].str.split(r'\s+(?:feat\.|ft\.|featuring)\s+', flags=re.IGNORECASE).str[0].str.strip()
    
    # 4. Deduplicación (una sola versión por artista y título)
    df['key_dup'] = df['nombre'].str.lower().str.strip() + "___" + df['artista'].str.lower().str.strip()
    df = df.drop_duplicates(subset=['key_dup']).drop(columns=['key_dup'])
    
    # 5. Validar géneros e idiomas
    df = df[df['genero'].isin(GENEROS_PERMITIDOS)]
    df = df[df['idioma'].isin(IDIOMAS_PERMITIDOS)]
    
    # 6. Mapeo de artista argentino
    df['es_argentino'] = df['pais_artista'].astype(str).str.upper().isin(['ARGENTINA', 'ARG', 'AR'])
    
    # 7. Asignar grupo y calcular rating
    df['grupo'] = df.apply(lambda r: mapear_grupo(r['genero'], r['es_argentino'], r['idioma']), axis=1)
    
    ratings_verif = df.apply(calcular_rating, axis=1)
    df['rating'] = [rv[0] for rv in ratings_verif]
    df['verificacion'] = [rv[1] for rv in ratings_verif]
    
    # 8. Asignación de cuotas por grupo (Método del mayor resto)
    cuotas_target = {}
    restos = {}
    acumulado = 0
    
    for grupo, pct in CUOTAS_GRUPOS.items():
        exacto = N_TARGET * pct
        base = int(exacto)
        cuotas_target[grupo] = base
        restos[grupo] = exacto - base
        acumulado += base
        
    faltante = N_TARGET - acumulado
    for grupo in sorted(restos, key=restos.get, reverse=True)[:faltante]:
        cuotas_target[grupo] += 1

    # 9. Selección respetando cuotas y prioridad de rating
    seleccionados = []
    
    for grupo, cupo in cuotas_target.items():
        sub_df = df[df['grupo'] == grupo].sort_values(by='rating', ascending=False)
        tomados = sub_df.head(cupo)
        seleccionados.append(tomados)
        
    df_resultado = pd.concat(seleccionados)
    
    # Reasignación si algún grupo no completó su cupo
    if len(df_resultado) < N_TARGET:
        faltantes = N_TARGET - len(df_resultado)
        ids_usados = set(df_resultado.index)
        remanente = df[~df.index.isin(ids_usados)].sort_values(by='rating', ascending=False)
        df_resultado = pd.concat([df_resultado, remanente.head(faltantes)])
        
    # 10. Garantizar mínimo de 20% de artistas argentinos
    cant_arg = df_resultado['es_argentino'].sum()
    min_arg_requerido = int(N_TARGET * PORC_ARG_MIN)
    
    if cant_arg < min_arg_requerido:
        diferencia = min_arg_requerido - cant_arg
        ids_usados = set(df_resultado.index)
        
        # Buscar temas argentinos no seleccionados
        arg_remanente = df[(df['es_argentino']) & (~df.index.isin(ids_usados))].sort_values(by='rating', ascending=False)
        
        if len(arg_remanente) >= diferencia:
            # Reemplazar los de menor rating no argentinos
            no_arg_seleccionados = df_resultado[~df_resultado['es_argentino']].sort_values(by='rating', ascending=True)
            ids_a_reemplazar = no_arg_seleccionados.head(diferencia).index
            
            df_resultado = df_resultado.drop(index=ids_a_reemplazar)
            df_resultado = pd.concat([df_resultado, arg_remanente.head(diferencia)])

    # Orden final por rating descendente
    df_resultado = df_resultado.sort_values(by='rating', ascending=False)
    
    # 11. Formato final de columnas exigidas
    columnas_finales = ['nombre', 'genero', 'artista', 'idioma', 'anio', 'rating', 'verificacion']
    df_export = df_resultado[columnas_finales]
    
    # Guardar CSV
    df_export.to_csv(path_csv_salida, index=False, encoding='utf-8')
    
    # 12. Imprimir resumen final
    print("=== RESUMEN DE EJECUCIÓN ===")
    print(f"Total procesado de entrada: {total_inicial} filas")
    print(f"Total exportado: {len(df_export)} canciones")
    print("\nCantidad de canciones por grupo:")
    for grupo, count in df_resultado['grupo'].value_counts().items():
        print(f"  - {grupo}: {count}")
        
    porc_arg_real = (df_resultado['es_argentino'].sum() / len(df_resultado)) * 100
    print(f"\nPorcentaje final de artistas argentinos: {porc_arg_real:.2f}%")
    
    no_verif_count = (df_resultado['verificacion'] == 'no verificado').sum()
    print(f"Canciones marcadas como 'no verificado': {no_verif_count}")

# Ejecución de prueba
if __name__ == "__main__":
    procesar_catalogo("canciones_90s_raw.csv", "listado_10000_canciones_90s.csv")







    